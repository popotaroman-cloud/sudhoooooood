@startuml faculty-admin-overview
!theme plain
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam package {
  BackgroundColor #F8F9FA
  BorderColor     #CED4DA
  FontStyle       bold
  FontSize        13
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor     #6C757D
  FontSize        11
}
skinparam database {
  BackgroundColor #EBF5FB
  BorderColor     #5DADE2
}
skinparam arrow {
  Color           #495057
  FontSize        10
}

' ============================================================
' CLIENT LAYER
' ============================================================
package "Client Layer  (Multi-device)" as CL {
  [Web Browser\nReact / Vue / Next.js]  as WEB
  [Mobile App\niOS / Android (PWA)]     as MOB
  [Tablet / Kiosk\nIn-campus terminal]  as TAB
}

' ============================================================
' EDGE LAYER
' ============================================================
package "Edge Layer" as EL {

  package "Traefik  (API Gateway)" as TRAEFIK_PKG {
    [TLS Termination\n& Cert Manager]  as TLS
    [Load Balancer\n& Health Check]    as LB
    [Rate Limiting\n& Circuit Breaker] as RL
    [Dynamic Routing\n(path / header)] as RT
  }

  package "OPA  (Open Policy Agent)" as OPA_PKG {
    [Policy Engine\n(Rego rules)]              as PE
    [RBAC / ABAC\n(Role + Attribute)]          as RBAC
    [Row-level Filter\n(Data masking rules)]   as DM
  }

}

' ============================================================
' IDENTITY
' ============================================================
package "Identity & Auth" as ID {
  [SSO / LDAP\nKeycloak / Auth0]  as AUTH
  [JWT / Session\nToken Store]    as TOKEN
}

' ============================================================
' BPMN PROCESS ENGINE
' ============================================================
package "BPMN Process Engine" as PE_PKG {
  [Camunda / Flowable\nProcess Definitions]  as BPMN_DEF
  [Task Manager\n(Human Tasks / Timers)]     as BPMN_TASK
  [Workflow REST API\n(start / complete)]    as BPMN_API
}

' ============================================================
' APPLICATION MODULES  (Modular Monolith)
' ============================================================
package "Application Modules  (Modular Monolith)" as AM {

  package "Finance Domain" as FD {
    [Finance Module\nการเงิน / งบประมาณ]     as FIN
    [Procurement Module\nพัสดุ / จัดซื้อจัดจ้าง] as PROC
  }

  package "People Domain" as PD {
    [HR Module\nบุคคล / สรรหา / พัฒนา]      as HR
    [Student Affairs Module\nกิจการนักศึกษา / ทุน] as STU
  }

  package "Academic Domain" as AD {
    [Academic Module\nวิชาการ / ทะเบียน / หลักสูตร] as ACAD
    [Research Module\nวิจัย / บริการวิชาการ]         as RES
  }

  package "Operations Domain" as OD {
    [Facility Module\nอาคาร / สถานที่ / ยานพาหนะ]  as FAC
    [IT Admin Module\nระบบสารสนเทศ / เครือข่าย]    as IT
  }

  package "Strategy Domain" as SD {
    [Planning & QA Module\nแผนงาน / ประกันคุณภาพ / รายงาน] as PLAN
    [Document & Archive\nสารบรรณ / เอกสารราชการ]             as DOC
  }

}

' ============================================================
' DATA LAYER
' ============================================================
package "Data Layer" as DL {
  database "PostgreSQL\n(schema-per-module)"  as PG
  database "Redis\n(Cache / Session)"         as REDIS
  [MinIO\n(File / Document Store)]            as MINIO
  [Message Bus\n(RabbitMQ / NATS)]            as MQ
}

' ============================================================
' EXTERNAL INTEGRATIONS
' ============================================================
package "External Systems" as EXT {
  [GFMIS\n(ระบบการเงินภาครัฐ)]   as GFMIS
  [University ERP / SIS\n(ระบบกลางมหาวิทยาลัย)] as UNIERP
  [Email / SMS\nNotification]      as NOTIF
}

' ============================================================
' CONNECTIONS — Client → Edge
' ============================================================
WEB  --> TLS : HTTPS
MOB  --> TLS : HTTPS
TAB  --> TLS : HTTPS

TLS  --> LB
LB   --> RL
RL   --> RT

' ============================================================
' CONNECTIONS — Traefik → Auth + OPA (per request)
' ============================================================
RT  --> AUTH       : (1) authenticate\nJWT / session check
AUTH --> TOKEN
RT  --> PE         : (2) authorize\nForward Auth middleware
PE  --> RBAC
PE  --> DM

' ============================================================
' CONNECTIONS — Traefik → Modules
' ============================================================
RT  --> FIN  : /api/finance/**
RT  --> PROC : /api/procurement/**
RT  --> HR   : /api/hr/**
RT  --> STU  : /api/student/**
RT  --> ACAD : /api/academic/**
RT  --> RES  : /api/research/**
RT  --> FAC  : /api/facility/**
RT  --> IT   : /api/it/**
RT  --> PLAN : /api/planning/**
RT  --> DOC  : /api/document/**

' ============================================================
' CONNECTIONS — OPA enforces on modules
' ============================================================
PE  ..> FIN  : allow / deny + filter
PE  ..> PROC : allow / deny + filter
PE  ..> HR   : allow / deny + filter
PE  ..> ACAD : allow / deny + filter

' ============================================================
' CONNECTIONS — BPMN triggers module workers
' ============================================================
BPMN_API  --> FIN  : Leave approval flow\nBudget request flow
BPMN_API  --> PROC : Procurement approval\nContract workflow
BPMN_API  --> HR   : Onboarding flow\nPerformance review
BPMN_API  --> ACAD : Course approval\nExam committee flow
BPMN_API  --> RES  : Research grant approval
BPMN_TASK --> MQ   : async task events

' ============================================================
' CONNECTIONS — Modules → Data
' ============================================================
FIN  --> PG
PROC --> PG
HR   --> PG
STU  --> PG
ACAD --> PG
RES  --> PG
FAC  --> PG
PLAN --> PG

AUTH  --> REDIS
FIN   --> REDIS : cache lookups
ACAD  --> REDIS : cache lookups

HR   --> MINIO : employee docs
PROC --> MINIO : contract files
RES  --> MINIO : research papers
DOC  --> MINIO : official documents

FIN  --> MQ : budget events
PROC --> MQ : PO events
HR   --> MQ : staff events

' ============================================================
' CONNECTIONS — External
' ============================================================
FIN  --> GFMIS   : sync transactions
ACAD --> UNIERP  : student data sync
HR   --> UNIERP  : staff data sync
MQ   --> NOTIF   : email / SMS dispatch

@enduml
